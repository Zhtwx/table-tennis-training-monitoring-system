# Flask 基础配置
FLASK_ENV=development
SECRET_KEY=change-this-secret-key

# Docker Desktop MySQL 配置
# 从你的截图看：
# - my-mysql-55: 127.0.0.1:3306 -> 容器内 3306
# - my-mysql-8:  127.0.0.1:3307 -> 容器内 3306
# 如果使用 MySQL 5.5 容器，DB_PORT 填 3306。
# 如果使用 MySQL 8.0 容器，DB_PORT 填 3307。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=coach_app
DB_PASSWORD=Coach2026#
DB_NAME=pingpang_db
DB_CONNECT_TIMEOUT=1
MAX_CONTENT_LENGTH=5242880
